{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "client": {
      "projectType": "application",
      "root": "projects/client",
      "sourceRoot": "projects/client/src",
      "prefix": "app",
      "architect": {
        "build": {"builder": "@angular/build:application", "options": {"outputPath": "dist/client", "index": "projects/client/src/index.html", "browser": "projects/client/src/main.ts", "tsConfig": "projects/client/tsconfig.app.json", "assets": [{"glob":"**/*","input":"projects/client/public"}], "styles": ["projects/client/src/styles.css"]}},
        "serve": {"builder": "@angular/build:dev-server", "configurations": {"development": {"buildTarget": "client:build"}}, "defaultConfiguration": "development"}
      }
    },
    "admin": {
      "projectType": "application",
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "app",
      "architect": {
        "build": {"builder": "@angular/build:application", "options": {"outputPath": "dist/admin", "index": "projects/admin/src/index.html", "browser": "projects/admin/src/main.ts", "tsConfig": "projects/admin/tsconfig.app.json", "assets": [{"glob":"**/*","input":"projects/admin/public"}], "styles": ["projects/admin/src/styles.css"]}},
        "serve": {"builder": "@angular/build:dev-server", "configurations": {"development": {"buildTarget": "admin:build"}}, "defaultConfiguration": "development"}
      }
    }
  }
}
