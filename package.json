{
  "name": "neu-trading-app-demo-ang-ui",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start:client": "ng serve client --port 4200",
    "start:admin": "ng serve admin --port 4201",
    "build": "npm run build:client && npm run build:admin",
    "build:client": "ng build client",
    "build:admin": "ng build admin",
    "test": "npm run test:client && npm run test:admin",
    "test:client": "ng test client --watch=false",
    "test:admin": "ng test admin --watch=false",
    "test:watch:client": "ng test client",
    "test:watch:admin": "ng test admin",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,css}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,css}\""
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "chart.js": "^4.5.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
"devDependencies": {
  "@angular/build": "^21.0.0",
  "@angular/cli": "^21.0.0",
  "@angular/compiler-cli": "^21.0.0",
  "@vitest/coverage-v8": "^4.1.11",
  "jsdom": "^27.0.0",
  "prettier": "^3.6.2",
  "typescript": "~5.9.2",
  "vitest": "^4.0.0"
},
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.1": true
  }
}
